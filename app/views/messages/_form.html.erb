<div id="form">
  <%= form_with model: message do |form| %>
      <div class="form-item">
        <%= form.label :title %>
        <%= form.text_field :title %>
      </div>

      <div class="form-item">
        <%= form.label :description, style: "display: block" %>
        <%= form.rich_text_area :description %>
      </div>

      <div class="form-item">
        <%= form.label :featured_image, style: "display: block" %>
        <%= form.file_field :featured_image, accept: "image/*" %>
      </div>

      <div class="form-item">

        <%= form.label :video, style: "display: block" %>
        <%= form.file_field :video, accept: "video/mp4" %>
      </div>
    
      <div class="form-buttons">
        <%= form.submit "Submit", class: "form-button submit-button" %>
        <%= link_to "Cancel", messages_path, class: "form-button cancel-button" %>
      </div>
  <% end %>
</div>