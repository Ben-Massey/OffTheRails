<h1><%= t ".title" %></h1>

<%= link_to "New message", new_message_path %>

<div id="message">
  <% @message.each do |message| %>
    <%= link_to message do %>
      <div>
        <div id="thumbnail">
          <%= image_tag url_for(message.featured_image) if message.featured_image.attached? %>
        </div>
        <div id="title">
          <%= message.title %>
        </div>
        <div id="description">
          <%= message.description %>
        </div>
        <%= link_to "Edit", edit_message_path(message) %>
      </div>
    <% end %>
  <% end %>
</div>